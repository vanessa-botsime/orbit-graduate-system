@startuml
title Orbit - use cases
left to right direction
actor "Job seeker" as U
actor "Google (Gmail, Calendar)" as G <<planned>>

rectangle Orbit {
  usecase "Register / sign in" as UC1
  usecase "Track applications through stages" as UC2
  usecase "See deadlines that need action" as UC3
  usecase "Check CV match for a job" as UC4
  usecase "Check a posting for scam signals" as UC5
  usecase "View activity log" as UC6
  usecase "Plan focus time around calendar" as UC7 <<planned>>
  usecase "Detect job emails" as UC8 <<planned>>
  usecase "Use offline" as UC9 <<planned>>
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8
U --> UC9
UC7 --> G
UC8 --> G
@enduml
